# Copie este arquivo para ".env" se quiser trocar algum valor.
# Os valores abaixo ja sao os padroes usados no desenvolvimento.

# Chave usada para assinar o token de login (JWT)
SECRET_KEY=troque-esta-chave-em-producao-0123456789abcdef

# Tempo (em minutos) ate o token de login expirar
TOKEN_EXPIRE_MINUTES=30

# Chave Fernet usada para criptografar o CPF dos tutores.
# ATENCAO: os CPFs do banco/script.sql foram criptografados com a chave abaixo.
# Se trocar a chave, gere novos valores com:  python utils_seed.py cpf 12345678909
ENCRYPTION_KEY=xNUBAyLrhptOWk5DVeV4XUcZ3ULyFOFnU9b1pSWHoDY=

# Origens liberadas no CORS (separadas por virgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
